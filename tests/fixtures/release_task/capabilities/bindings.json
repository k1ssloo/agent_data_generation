{
  "binding_version": "tool-binding-v1",
  "tools": [
    {
      "name": "find_project_space",
      "description": "Find a release workspace by its public project name.",
      "capability_id": "workspace.find.v1",
      "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}
    },
    {
      "name": "load_channel_rules",
      "description": "Read release requirements for a workspace and channel.",
      "capability_id": "policy.read.v1",
      "parameters": {"type": "object", "properties": {"space_ref": {"type": "string"}, "channel": {"type": "string"}}, "required": ["space_ref", "channel"]},
      "input_map": {"space_ref": "workspace_handle"},
      "provenance_required": ["space_ref"]
    },
    {
      "name": "locate_revision",
      "description": "Resolve a requested version to a source and default test plan.",
      "capability_id": "source.resolve.v1",
      "parameters": {"type": "object", "properties": {"space_ref": {"type": "string"}, "version": {"type": "string"}}, "required": ["space_ref", "version"]},
      "input_map": {"space_ref": "workspace_handle"},
      "provenance_required": ["space_ref"]
    },
    {
      "name": "start_test_run",
      "description": "Start an asynchronous quality run.",
      "capability_id": "test.start.v1",
      "parameters": {"type": "object", "properties": {"source_ref": {"type": "string"}, "plan_ref": {"type": "string"}}, "required": ["source_ref", "plan_ref"]},
      "input_map": {"source_ref": "source_handle", "plan_ref": "plan_handle"},
      "provenance_required": ["source_ref", "plan_ref"]
    },
    {
      "name": "check_run",
      "description": "Observe the current state and outputs of an asynchronous run.",
      "capability_id": "run.poll.v1",
      "parameters": {"type": "object", "properties": {"run_ref": {"type": "string"}}, "required": ["run_ref"]},
      "input_map": {"run_ref": "run_handle"},
      "provenance_required": ["run_ref"]
    },
    {
      "name": "diagnose_quality",
      "description": "Inspect a failed quality report and identify missing tests.",
      "capability_id": "quality.inspect.v1",
      "parameters": {"type": "object", "properties": {"report_ref": {"type": "string"}}, "required": ["report_ref"]},
      "input_map": {"report_ref": "report_handle"},
      "provenance_required": ["report_ref"]
    },
    {
      "name": "revise_test_plan",
      "description": "Create a revised test plan from a diagnosis report.",
      "capability_id": "test_plan.revise.v1",
      "parameters": {"type": "object", "properties": {"base_plan_ref": {"type": "string"}, "diagnosis_ref": {"type": "string"}}, "required": ["base_plan_ref", "diagnosis_ref"]},
      "input_map": {"base_plan_ref": "plan_handle", "diagnosis_ref": "diagnosis_handle"},
      "provenance_required": ["base_plan_ref", "diagnosis_ref"]
    },
    {
      "name": "build_signed_package",
      "description": "Build and sign an Android artifact from source.",
      "capability_id": "build.signed.v1",
      "parameters": {"type": "object", "properties": {"source_ref": {"type": "string"}}, "required": ["source_ref"]},
      "input_map": {"source_ref": "source_handle"},
      "provenance_required": ["source_ref"]
    },
    {
      "name": "start_security_scan",
      "description": "Start an asynchronous security scan for an artifact.",
      "capability_id": "security.start.v1",
      "parameters": {"type": "object", "properties": {"artifact_ref": {"type": "string"}}, "required": ["artifact_ref"]},
      "input_map": {"artifact_ref": "artifact_handle"},
      "provenance_required": ["artifact_ref"]
    },
    {
      "name": "prepare_candidate",
      "description": "Assemble policy, test, security, and artifact evidence into a release candidate.",
      "capability_id": "candidate.prepare.v1",
      "parameters": {"type": "object", "properties": {"policy_ref": {"type": "string"}, "artifact_ref": {"type": "string"}, "test_report_ref": {"type": "string"}, "security_report_ref": {"type": "string"}}, "required": ["policy_ref", "artifact_ref", "test_report_ref", "security_report_ref"]},
      "input_map": {"policy_ref": "policy_handle", "artifact_ref": "artifact_handle", "test_report_ref": "test_report_handle", "security_report_ref": "security_report_handle"},
      "provenance_required": ["policy_ref", "artifact_ref", "test_report_ref", "security_report_ref"]
    },
    {
      "name": "publish_candidate",
      "description": "Distribute a ready candidate to a channel.",
      "capability_id": "release.publish.v1",
      "parameters": {"type": "object", "properties": {"candidate_ref": {"type": "string"}, "channel": {"type": "string"}}, "required": ["candidate_ref", "channel"]},
      "input_map": {"candidate_ref": "candidate_handle"},
      "provenance_required": ["candidate_ref"]
    },
    {
      "name": "inspect_release_evidence",
      "description": "Read final release state and policy evidence.",
      "capability_id": "release.inspect.v1",
      "parameters": {"type": "object", "properties": {"distribution_ref": {"type": "string"}}, "required": ["distribution_ref"]},
      "input_map": {"distribution_ref": "distribution_handle"},
      "provenance_required": ["distribution_ref"]
    }
  ]
}
