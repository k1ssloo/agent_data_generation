  "capabilities": {
    "wikihow.open_resource.v1": {
      "branches": [
        {
          "id": "observed_01",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.resource_type",
                  "app"
                ]
              },
              {
                "eq": [
                  "$args.target",
                  "Settings"
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "message": "Settings application opened successfully."
          },
          "effects": [],
          "reads": [],
          "writes": []
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "WIKIHOW_OPEN_RESOURCE_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.get_record.v1": {
      "branches": [
        {
          "id": "observed_02",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.collection",
                  "settings"
                ]
              },
              {
                "eq": [
                  "$args.record_id",
                  "security_settings"
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "record": {
              "id": "security_settings",
              "screen_lock_type": "none",
              "lock_value": null,
              "options_available": [
                "none",
                "slide",
                "face_unlock",
                "voice_unlock",
                "pattern",
                "pin",
                "password"
              ]
            }
          },
          "effects": [],
          "reads": [],
          "writes": []
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "WIKIHOW_GET_RECORD_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.update_record.v1": {
      "branches": [
        {
          "id": "observed_03",
          "when": {
            "all": [
              {
                "all": [
                  {
                    "eq": [
                      "$args.collection",
                      "settings"
                    ]
                  },
                  {
                    "eq": [
                      "$args.patch",
                      {
                        "screen_lock_type": "pin",
                        "lock_value": "2580"
                      }
                    ]
                  },
                  {
                    "eq": [
                      "$args.record_id",
                      "security_settings"
                    ]
                  }
                ]
              },
              {
                "eq": [
                  "$args.approval_handle",
                  "approval_workflow_commit_1"
                ]
              },
              {
                "eq": [
                  "$state.workflow_commit_audit.reviewed",
                  true
                ]
              },
              {
                "eq": [
                  "$args.record_id",
                  "$state.workflow_commit_audit.target"
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "message": "Screen lock updated to PIN."
          },
          "effects": [
            {
              "set": "$state.device_status",
              "value": {
                "screen_locked": false,
                "active_lock_type": "pin"
              }
            },
            {
              "set": "$state.settings",
              "value": {
                "security_settings": {
                  "id": "security_settings",
                  "screen_lock_type": "pin",
                  "lock_value": "2580",
                  "options_available": [
                    "none",
                    "slide",
                    "face_unlock",
                    "voice_unlock",
                    "pattern",
                    "pin",
                    "password"
                  ]
                }
              }
            },
            {
              "set": "$state.workflow_commit_audit.committed",
              "value": true
            }
          ],
          "reads": [
            "$state.workflow_commit_audit.reviewed",
            "$state.workflow_commit_audit.target"
          ],
          "writes": [
            "$state.device_status",
            "$state.settings",
            "$state.workflow_commit_audit.committed"
          ]
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "WIKIHOW_UPDATE_RECORD_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.read_state.v1": {
      "branches": [
        {
          "id": "observed_04",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.target_id",
                  ""
                ]
              },
              {
                "eq": [
                  "$args.view",
                  "device_status"
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "device_status": {
              "screen_locked": false,
              "active_lock_type": "pin"
            }
          },
          "effects": [],
          "reads": [],
          "writes": []
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "WIKIHOW_READ_STATE_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.workflow_context.observe.v1": {
      "branches": [
        {
          "id": "workflow_context_visible",
          "when": true,
          "response": {
            "workflow_context_handle": "$state.workflow_context.handle"
          },
          "effects": [],
          "reads": [
            "$state.workflow_context.handle"
          ],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.workflow_outcome.observe.v1": {
      "branches": [
        {
          "id": "current_workflow_outcome_visible",
          "when": {
            "eq": [
              "$args.workflow_context_handle",
              "$state.workflow_context.handle"
            ]
          },
          "response": {
            "outcome_state": {
              "device_status": "$state.device_status",
              "settings": "$state.settings",
              "workflow_context": "$state.workflow_context"
            },
            "audit_committed": "$state.workflow_commit_audit.committed"
          },
          "effects": [],
          "reads": [
            "$state.workflow_context.handle",
            "$state.device_status",
            "$state.settings",
            "$state.workflow_context",
            "$state.workflow_commit_audit.committed"
          ],
          "writes": [],
          "resolves_errors": []
        },
        {
          "id": "workflow_context_mismatch",
          "when": true,
          "response": {
            "error_code": "WORKFLOW_CONTEXT_MISMATCH",
            "recoverable": false
          },
          "effects": [],
          "reads": [
            "$state.workflow_context.handle"
          ],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "audit.inspect.workflow_commit.v1": {
      "branches": [
        {
          "id": "policy_discovered",
          "when": true,
          "response": {
            "policy_handle": "policy_workflow_commit_audit_1",
            "scope": "workflow_commit",
            "requires_explicit_review": true
          },
          "reads": [
            "$state.workflow_commit_audit"
          ]
        }
      ]
    },
    "audit.approve.workflow_commit.v1": {
      "branches": [
        {
          "id": "target_reviewed",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.policy_handle",
                  "policy_workflow_commit_audit_1"
                ]
              }
            ]
          },
          "response": {
            "approval_handle": "approval_workflow_commit_1",
            "approved_target": "$args.target_handle"
          },
          "effects": [
            {
              "set": "$state.workflow_commit_audit.reviewed",
              "value": true
            },
            {
              "set": "$state.workflow_commit_audit.target",
              "value": "$args.target_handle"
            }
          ],
          "writes": [
            "$state.workflow_commit_audit.reviewed",
            "$state.workflow_commit_audit.target"
          ]
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "AUDIT_APPROVE_WORKFLOW_COMMIT_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    }
