{
  "contract_version": "task-contract-v1",
  "goal": "Log into 4shared, navigate to the desired folder, configure the sharing and access settings, and share the folder with others.",
  "goal_predicates": [
    {
      "id": "wikihow_outcome",
      "predicate": {
        "all": [
          {
            "eq": [
              "$state.active_session",
              {
                "authenticated": true,
                "user": "user@example.com"
              }
            ]
          },
          {
            "eq": [
              "$state.files",
              {
                "folder_photos_2023": {
                  "id": "folder_photos_2023",
                  "name": "Photos 2023",
                  "type": "folder",
                  "visibility": "private",
                  "recipients": [
                    "friend@example.com"
                  ]
                }
              }
            ]
          },
          {
            "eq": [
              "$state.workflow_commit_audit.committed",
              true
            ]
          }
        ]
      }
    }
  ],
  "invariants": [
    {
      "id": "workflow_state_remains_structured",
      "predicate": {
        "all": [
          {
            "exists": "$state.active_session"
          },
          {
            "exists": "$state.files"
          },
          {
            "exists": "$state.workflow_context"
          }
        ]
      }
    }
  ],
  "requirements": {
    "semantic_recovery": false,
    "async_decision": false,
    "goal_grounded_verification": true
  },
  "forbidden_shortcuts": [
    "claim completion without producing the WikiHow workflow outcome",
    "claim completion without inspecting the resulting state",
    "perform workflow_commit commit without target-specific reviewed evidence"
  ],
  "expected_reasoning_features": [
    "derived_object_dependency",
    "goal_grounded_verification"
  ],
  "counterfactual_axes": []
}
