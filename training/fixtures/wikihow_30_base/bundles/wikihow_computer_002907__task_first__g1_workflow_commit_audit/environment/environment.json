        "name": "Documents",
        "type": "system_folder"
      }
    },
    "files": {
      "criterion_folder": {
        "id": "criterion_folder",
        "name": "Criterion Games",
        "parent": "documents_root",
        "type": "folder",
        "description": "Need for Speed Hot Pursuit save files"
      }
    },
    "workflow_context": {
      "handle": "workflow_context_wikihow_computer_002907",
      "source_task_id": "wikihow_computer_002907"
    },
    "workflow_commit_audit": {
      "reviewed": false,
      "target": "",
      "committed": false
    }
  },
  "capabilities": {
    "wikihow.open_resource.v1": {
      "branches": [
        {
          "id": "observed_01",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.resource_type",
                  "folder"
                ]
              },
              {
                "eq": [
                  "$args.target",
                  "Documents"
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "message": "Documents folder opened successfully.",
            "current_folder": "documents_root"
          },
          "effects": [],
          "reads": [],
          "writes": []
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "WIKIHOW_OPEN_RESOURCE_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.list_records.v1": {
      "branches": [
        {
          "id": "observed_02",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.collection",
                  "files"
                ]
              },
              {
                "eq": [
                  "$args.query",
                  ""
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "files": [
              {
                "id": "criterion_folder",
                "name": "Criterion Games",
                "parent": "documents_root",
                "type": "folder",
                "description": "Need for Speed Hot Pursuit save files"
              }
            ]
          },
          "effects": [],
          "reads": [],
          "writes": []
        },
        {
          "id": "observed_04",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.collection",
                  "files"
                ]
              },
              {
                "eq": [
                  "$args.query",
                  ""
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "files": []
          },
          "effects": [],
          "reads": [],
          "writes": []
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "WIKIHOW_LIST_RECORDS_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.delete_record.v1": {
      "branches": [
        {
          "id": "observed_03",
          "when": {
            "all": [
              {
                "all": [
                  {
                    "eq": [
                      "$args.collection",
                      "files"
                    ]
                  },
                  {
                    "eq": [
                      "$args.record_id",
                      "criterion_folder"
                    ]
                  }
                ]
              },
              {
                "eq": [
                  "$args.approval_handle",
                  "approval_workflow_commit_1"
                ]
              },
              {
                "eq": [
                  "$state.workflow_commit_audit.reviewed",
                  true
                ]
              },
              {
                "eq": [
                  "$args.record_id",
                  "$state.workflow_commit_audit.target"
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "message": "Folder deleted successfully."
          },
          "effects": [
            {
              "set": "$state.files",
              "value": {}
            },
            {
              "set": "$state.workflow_commit_audit.committed",
              "value": true
            }
          ],
          "reads": [
            "$state.files[$args.record_id]",
            "$state.workflow_commit_audit.reviewed",
            "$state.workflow_commit_audit.target"
          ],
          "writes": [
            "$state.files",
            "$state.workflow_commit_audit.committed"
          ]
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "WIKIHOW_DELETE_RECORD_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.workflow_context.observe.v1": {
      "branches": [
        {
          "id": "workflow_context_visible",
          "when": true,
          "response": {
            "workflow_context_handle": "$state.workflow_context.handle"
          },
          "effects": [],
          "reads": [
            "$state.workflow_context.handle"
          ],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "wikihow.workflow_outcome.observe.v1": {
      "branches": [
        {
          "id": "current_workflow_outcome_visible",
          "when": {
            "eq": [
              "$args.workflow_context_handle",
              "$state.workflow_context.handle"
            ]
          },
          "response": {
            "outcome_state": {
              "files": "$state.files",
              "workflow_context": "$state.workflow_context"
            },
            "audit_committed": "$state.workflow_commit_audit.committed"
          },
          "effects": [],
          "reads": [
            "$state.workflow_context.handle",
            "$state.files",
            "$state.workflow_context",
            "$state.workflow_commit_audit.committed"
          ],
          "writes": [],
          "resolves_errors": []
        },
        {
          "id": "workflow_context_mismatch",
          "when": true,
          "response": {
            "error_code": "WORKFLOW_CONTEXT_MISMATCH",
            "recoverable": false
          },
          "effects": [],
          "reads": [
            "$state.workflow_context.handle"
          ],
          "writes": [],
          "resolves_errors": []
        }
      ]
    },
    "audit.inspect.workflow_commit.v1": {
      "branches": [
        {
          "id": "policy_discovered",
          "when": true,
          "response": {
            "policy_handle": "policy_workflow_commit_audit_1",
            "scope": "workflow_commit",
            "requires_explicit_review": true
          },
          "reads": [
            "$state.workflow_commit_audit"
          ]
        }
      ]
    },
    "audit.approve.workflow_commit.v1": {
      "branches": [
        {
          "id": "target_reviewed",
          "when": {
            "all": [
              {
                "eq": [
                  "$args.policy_handle",
                  "policy_workflow_commit_audit_1"
                ]
              }
            ]
          },
          "response": {
            "approval_handle": "approval_workflow_commit_1",
            "approved_target": "$args.target_handle"
          },
          "effects": [
            {
              "set": "$state.workflow_commit_audit.reviewed",
              "value": true
            },
            {
              "set": "$state.workflow_commit_audit.target",
              "value": "$args.target_handle"
            }
          ],
          "writes": [
            "$state.workflow_commit_audit.reviewed",
            "$state.workflow_commit_audit.target"
          ]
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
            "error_code": "AUDIT_APPROVE_WORKFLOW_COMMIT_V1_INPUT_NOT_APPLICABLE",
            "message": "The public arguments are well-formed but do not identify an applicable action in the current observable workflow.",
            "retryable": true
          },
          "effects": [],
          "reads": [],
          "writes": [],
          "resolves_errors": []
        }
      ]
    }
  }
}
