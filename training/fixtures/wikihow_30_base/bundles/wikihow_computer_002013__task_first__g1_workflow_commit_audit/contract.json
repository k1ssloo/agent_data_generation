{
  "contract_version": "task-contract-v1",
  "goal": "How to find low airfares by searching at specific times and clearing browser cookies.",
  "goal_predicates": [
    {
      "id": "wikihow_outcome",
      "predicate": {
        "all": [
          {
            "eq": [
              "$state.bookings",
              {
                "booking_991": {
                  "id": "booking_991",
                  "flight_id": "flight_nyc_lon_blooper",
                  "status": "confirmed"
                }
              }
            ]
          },
          {
            "eq": [
              "$state.settings",
              {
                "browser_settings": {
                  "id": "browser_settings",
                  "cookies_cleared": true,
                  "browser_name": "Internet Explorer"
                }
              }
            ]
          },
          {
            "eq": [
              "$state.workflow_commit_audit.committed",
              true
            ]
          }
        ]
      }
    }
  ],
  "invariants": [
    {
      "id": "workflow_state_remains_structured",
      "predicate": {
        "all": [
          {
            "exists": "$state.bookings"
          },
          {
            "exists": "$state.settings"
          },
          {
            "exists": "$state.workflow_context"
          }
        ]
      }
    }
  ],
  "requirements": {
    "semantic_recovery": false,
    "async_decision": false,
    "goal_grounded_verification": true
  },
  "forbidden_shortcuts": [
    "claim completion without producing the WikiHow workflow outcome",
    "claim completion without inspecting the resulting state",
    "perform workflow_commit commit without target-specific reviewed evidence"
  ],
  "expected_reasoning_features": [
    "derived_object_dependency",
    "goal_grounded_verification"
  ],
  "counterfactual_axes": []
}
