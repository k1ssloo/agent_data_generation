{
  "binding_version": "tool-binding-v1",
  "tools": [
    {
      "name": "observe_workflow_context",
      "description": "Observe the public context for the current workflow before acting.",
      "capability_id": "wikihow.workflow_context.observe.v1",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "provenance_required": []
    },
    {
      "name": "open_resource",
      "description": "Open an application, page, service, URL, or workspace so later tools can inspect or modify it.",
      "capability_id": "wikihow.open_resource.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "resource_type": {
            "type": "string",
            "description": "Kind of resource, such as app, website, page, service, folder, or workspace.",
            "enum": [
              "app"
            ]
          },
          "target": {
            "type": "string",
            "description": "Name, URL, or identifier of the resource to open."
          }
        },
        "required": [
          "resource_type",
          "target"
        ]
      }
    },
    {
      "name": "authenticate",
      "description": "Authenticate to a service or account using a provided credential.",
      "capability_id": "wikihow.authenticate.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "Service or application to authenticate against."
          },
          "account_id": {
            "type": "string",
            "description": "Account, user, or profile identifier."
          },
          "credential_type": {
            "type": "string",
            "description": "Credential type, such as password, picture_password, token, or sso."
          },
          "credential_value": {
            "type": "string",
            "description": "Credential value supplied by the user or prior state."
          }
        },
        "required": [
          "service",
          "account_id",
          "credential_type",
          "credential_value"
        ]
      }
    },
    {
      "name": "search_records",
      "description": "Search a named collection for records matching a user-visible query.",
      "capability_id": "wikihow.search_records.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection to search.",
            "enum": [
              "skype_directory"
            ]
          },
          "query": {
            "type": "string",
            "description": "Search query grounded in the user request or prior tool output."
          }
        },
        "required": [
          "collection",
          "query"
        ]
      }
    },
    {
      "name": "create_record",
      "description": "Create a record in a named collection.",
      "capability_id": "wikihow.create_record.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection where the record should be created.",
            "enum": [
              "contacts"
            ]
          },
          "fields": {
            "type": "object",
            "description": "Fields for the new record."
          }
        },
        "required": [
          "collection",
          "fields"
        ]
      }
    },
    {
      "name": "get_record",
      "description": "Retrieve one record from a named collection by id.",
      "capability_id": "wikihow.get_record.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection containing the record.",
            "enum": [
              "contacts"
            ]
          },
          "record_id": {
            "type": "string",
            "description": "Identifier of the record to retrieve."
          },
          "approval_ref": {
            "type": "string",
            "description": "Approval evidence derived for the exact commit target."
          }
        },
        "required": [
          "collection",
          "record_id",
          "approval_ref"
        ]
      },
      "provenance_required": [
        "record_id",
        "approval_ref"
      ],
      "input_map": {
        "approval_ref": "approval_handle"
      }
    },
    {
      "name": "start_job",
      "description": "Start a long-running job such as scan, export, download, import, or conversion.",
      "capability_id": "wikihow.start_job.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "job_type": {
            "type": "string",
            "description": "Type of job to start.",
            "enum": [
              "voice_call"
            ]
          },
          "target_id": {
            "type": "string",
            "description": "Target resource or record for the job."
          },
          "options": {
            "type": "object",
            "description": "Job options."
          }
        },
        "required": [
          "job_type",
          "target_id",
          "options"
        ]
      },
      "provenance_required": [
        "target_id"
      ]
    },
    {
      "name": "observe_workflow_outcome",
      "description": "Observe the resulting state for the same public workflow context.",
      "capability_id": "wikihow.workflow_outcome.observe.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "workflow_context_handle": {
            "type": "string",
            "description": "Opaque context returned by the initial workflow observation."
          }
        },
        "required": [
          "workflow_context_handle"
        ],
        "additionalProperties": false
      },
      "provenance_required": [
        "workflow_context_handle"
      ]
    },
    {
      "name": "inspect_workflow_commit_policy",
      "description": "Inspect the current evidence policy for workflow_commit.",
      "capability_id": "audit.inspect.workflow_commit.v1",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "approve_workflow_commit_action",
      "description": "Review a discovered target under the workflow_commit policy.",
      "capability_id": "audit.approve.workflow_commit.v1",
      "parameters": {
        "type": "object",
        "properties": {
          "policy_ref": {
            "type": "string"
          },
          "target_ref": {
            "type": "string"
          }
        },
        "required": [
          "policy_ref",
          "target_ref"
        ]
      },
      "input_map": {
        "policy_ref": "policy_handle",
        "target_ref": "target_handle"
      },
      "provenance_required": [
        "policy_ref",
        "target_ref"
      ]
    }
  ]
}
