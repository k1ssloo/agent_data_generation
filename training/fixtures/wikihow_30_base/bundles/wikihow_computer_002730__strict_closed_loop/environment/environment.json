            "$state.stress_control.stop_evidence",
            "$state.stress_control.cancellation_handle",
            "$state.stress_control.phase",
            "$state.system_metrics.performance_tab"
          ]
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
