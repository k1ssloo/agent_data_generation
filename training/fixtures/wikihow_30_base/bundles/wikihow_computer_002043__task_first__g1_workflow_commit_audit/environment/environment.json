    "wikihow.send_message.v1": {
      "branches": [
        {
          "id": "observed_03",
          "when": {
            "all": [
              {
                "all": [
                  {
                    "eq": [
                      "$args.body",
                      "Dear Dr. Miller, I am conducting research on Pablo Picasso and saw that you specialize in his work. I would appreciate the opportunity to sit in on one of your lectures regarding Picasso if possible. Please let me know if this would be alright. Thank you!"
                    ]
                  },
                  {
                    "eq": [
                      "$args.channel",
                      "email"
                    ]
                  },
                  {
                    "eq": [
                      "$args.recipient",
                      "a.miller@university.edu"
                    ]
                  },
                  {
                    "eq": [
                      "$args.subject",
                      "Inquiry about sitting in on your Picasso lecture"
                    ]
                  }
                ]
              },
              {
                "eq": [
                  "$args.approval_handle",
                  "approval_workflow_commit_1"
                ]
              },
              {
                "eq": [
                  "$state.workflow_commit_audit.reviewed",
                  true
                ]
              },
              {
                "eq": [
                  "$args.recipient",
                  "$state.workflow_commit_audit.target"
                ]
              }
            ]
          },
          "response": {
            "status": "success",
            "message": "Email sent successfully to $args.recipient"
          },
          "effects": [
            {
              "set": "$state.sent_emails",
              "value": [
                {
                  "recipient": "a.miller@university.edu",
                  "subject": "Inquiry about sitting in on your Picasso lecture",
                  "body": "Dear Dr. Miller, I am conducting research on Pablo Picasso and saw that you specialize in his work. I would appreciate the opportunity to sit in on one of your lectures regarding Picasso if possible. Please let me know if this would be alright. Thank you!",
                  "timestamp": "now"
                }
              ]
            },
            {
              "set": "$state.workflow_commit_audit.committed",
              "value": true
            }
          ],
          "reads": [
            "$state.workflow_commit_audit.reviewed",
            "$state.workflow_commit_audit.target"
          ],
          "writes": [
            "$state.sent_emails",
            "$state.workflow_commit_audit.committed"
          ]
        },
        {
          "id": "public_input_not_applicable",
          "when": true,
          "response": {
            "ok": false,
